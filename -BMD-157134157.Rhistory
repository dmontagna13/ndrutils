#' Mean ± SD summary helper for *ggplot2::stat_summary()*
#'
#' @param x Numeric vector.
#' @return A data frame with columns `y`, `ymin`, `ymax`.
#' @export
mean_sd <- function(x) {
data.frame(
y    = mean(x, na.rm = TRUE),
ymin = y - stats::sd(x, na.rm = TRUE),
ymax = y + stats::sd(x, na.rm = TRUE)
)
}
ggplot(mtcars, aes(x = cyl, y = disp)) +
stat_summary(fun.data, geom = "bar") +
stat_summary(fun.data = mean_sd, geom = "errorbar", width = 0.2) +
geom_point()
